generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

model User {
  id            String @id
  email         String @unique
  firstName     String?
  lastName      String?

  memberships   Membership[]
  documents     Document[]
  generations   AIGeneration[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Organisation {
  id              String @id
  name            String

  plan            Plan @default(FREE)

  memberships     Membership[]
  documents       Document[]
  usageMetrics    UsageMetric[]
  subscription    Subscription?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Membership {
  id              String @id @default(cuid())

  userId          String
  organisationId  String
  role            String

  user            User @relation(fields: [userId], references: [id])
  organisation    Organisation @relation(fields: [organisationId], references: [id])

  @@unique([userId, organisationId])
}

model Document {
  id              String @id @default(cuid())

  orgId           String
  authorId        String

  title           String
  content         String @default("")
  wordCount       Int @default(0)

  // Used as the collaboration room identifier
  collaborationRoomId String @unique

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation    Organisation @relation(fields: [orgId], references: [id])
  author          User @relation(fields: [authorId], references: [id])

  generations     AIGeneration[]
}

model AIGeneration {
  id              String @id @default(cuid())

  documentId      String
  userId          String

  prompt          String
  completion      String

  // Total tokens for this generation
  tokens          Int @default(0)

  // More detailed usage tracking
  inputTokens     Int @default(0)
  outputTokens    Int @default(0)

  model           String

  createdAt       DateTime @default(now())

  document        Document @relation(fields: [documentId], references: [id])
  user            User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([documentId, createdAt])
}

model UsageMetric {
  id                String @id @default(cuid())

  orgId             String
  month             String

  aiGenerations     Int @default(0)
  documentsCreated  Int @default(0)
  storageBytes      BigInt @default(0)

  organisation      Organisation @relation(fields: [orgId], references: [id])

  @@unique([orgId, month])
}

model Subscription {
  id                    String @id @default(cuid())

  organisationId        String @unique

  stripeCustomerId      String @unique
  stripeSubscriptionId  String? @unique

  status                SubscriptionStatus
  plan                  Plan

  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean @default(false)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organisation           Organisation @relation(fields: [organisationId], references: [id])

  @@index([stripeCustomerId])
}